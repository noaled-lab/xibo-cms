{# 미디어 테이블 tbody 부분만 렌더링 (AJAX 새로고침용) #}
{% for item in media %}
    <tr class="media-row" data-media-id="{{ item.itemId }}" style="cursor: pointer;">
        <td>{{ item.itemId }}</td>
        <td>{{ item.name }}</td>
        <td>{{ item.type }}</td>
        <td>{{ item.storedAs }}</td>
        <td>{{ item.size|byteFormat }}</td>
        <td title="{% if item.lastUsed == 0 %}{{ nonceNotUsed }}{% else %}{{ nonceUsed }}{% endif %}">
            <span class="fa {% if item.complete == 1 %}fa-check{% else %}fa-download{% endif %}"></span>
        </td>
        <td>{{ item.bytesRequested|byteFormat }}</td>
        <td>
            <span class="fa {% if item.released == 1 %}fa-check{% elseif item.released == 0  %}fa-cogs{% elseif item.released == 2  %}fa-times{% endif %}"></span>
        </td>
    </tr>
    {# 진행률 표시줄 행 #}
    <tr class="progress-row" data-media-id="{{ item.itemId }}" style="display: {% if item.complete != 1 %}table-row{% else %}none{% endif %};">
        <td colspan="8" style="padding: 8px 15px 12px 15px; background-color: #f9f9f9;">
            {# complete = 1이면 무조건 100%, 아니면 실제 진행률 계산 #}
            {% set downloadPercent = item.complete == 1 ? 100 : (item.size > 0 ? ((item.bytesDownloaded / item.size) * 100)|round(1) : 0) %}
            {% if downloadPercent < 30 %}
                {% set barColor = '#d9534f' %}
            {% elseif downloadPercent < 70 %}
                {% set barColor = '#f0ad4e' %}
            {% else %}
                {% set barColor = '#5cb85c' %}
            {% endif %}
            <div style="position: relative; background: #e9ecef; border-radius: 8px; height: 32px; overflow: hidden; box-shadow: inset 0 1px 2px rgba(0,0,0,0.1);">
                <div style="position: absolute; left: 0; top: 0; height: 100%; background: {{ barColor }}; width: {{ downloadPercent }}%; transition: width 0.3s ease; border-radius: 8px;"></div>
                <div style="position: relative; display: flex; align-items: center; justify-content: space-between; height: 100%; padding: 0 12px; z-index: 1;">
                    <span style="font-weight: 600; color: {% if downloadPercent > 50 %}#fff{% else %}#333{% endif %}; text-shadow: {% if downloadPercent > 50 %}0 1px 2px rgba(0,0,0,0.3){% else %}none{% endif %};">{{ downloadPercent }}%</span>
                    <span style="font-size: 13px; color: {% if downloadPercent > 50 %}rgba(255,255,255,0.9){% else %}#666{% endif %}; text-shadow: {% if downloadPercent > 50 %}0 1px 2px rgba(0,0,0,0.3){% else %}none{% endif %};">{{ item.complete == 1 ? item.size|byteFormat : item.bytesDownloaded|byteFormat }} / {{ item.size|byteFormat }}</span>
                </div>
            </div>
        </td>
    </tr>
{% endfor %}
