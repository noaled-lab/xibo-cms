{% extends "form-base.twig" %}
{% import "forms.twig" as forms %}

{% block formTitle %}
    {% trans "스트림 수정" %}
{% endblock %}

{% block formButtons %}
    {% trans "취소" %}, XiboDialogClose()
    {% trans "저장" %}, $("#cameraEditForm").submit()
{% endblock %}

{% block formHtml %}
    <div class="row">
        <div class="col-md-12">
            <form id="cameraEditForm" class="XiboForm form-horizontal" method="put"
                  action="{{ url_for("camera.edit", {id: camera.id}) }}"
                  data-camera-id="{{ camera.id }}"
                  data-mse-url="{{ mseUrl }}"
                  data-fisheye-params="{{ fisheyeParams|json_encode }}"
                  data-test-video-upload-url="{{ url_for("camera.testVideo.upload", {id: camera.id}) }}"
                  data-test-video-download-url="{{ url_for("camera.testVideo.download", {id: camera.id}) }}"
                  data-test-video-file="{{ camera.testVideoFile }}">

                <!-- 숨겨진 필드: onDemand는 항상 true -->
                <input type="hidden" name="onDemand" value="1">

                {% set title %}{% trans "이름" %}{% endset %}
                {% set helpText %}{% trans "카메라 채널의 이름을 입력하세요" %}{% endset %}
                {{ forms.input("name", title, camera.name, helpText, "", "required") }}

                {% set title %}{% trans "채널 번호" %}{% endset %}
                {% set helpText %}{% trans "카메라 채널 번호" %}{% endset %}
                {{ forms.disabled("channelId", title, camera.channelId, helpText) }}

                {% set title %}{% trans "RTSP URL" %}{% endset %}
                {% set helpText %}{% trans "카메라의 RTSP URL을 입력하세요 (예: rtsp://admin:admin@192.168.1.100/stream1)" %}{% endset %}
                {{ forms.input("url", title, camera.url, helpText, "", "required") }}

                {% set title %}{% trans "카메라 종류" %}{% endset %}
                {% set helpText %}{% trans "어안 렌즈 카메라를 선택하면 아래에서 디워핑 캘리브레이션을 할 수 있습니다." %}{% endset %}
                {% set options = [
                    {id: "standard", value: "일반"},
                    {id: "fisheye", value: "어안"}
                ] %}
                {{ forms.dropdown("type", "dropdown", title, camera.type, options, "id", "value", helpText) }}

                <div id="fisheyeCalibration" class="fisheye-calibration" style="display:none;">
                    <hr>
                    <h4>{% trans "어안 캘리브레이션" %}</h4>

                    <div class="form-group row">
                        <label class="col-sm-2 control-label">{% trans "미리보기" %}</label>
                        <div class="col-sm-10">
                            <div style="background:#000; max-width:480px;">
                                <canvas id="fisheyePreviewCanvas" style="width:100%; display:block;"></canvas>
                            </div>
                            <small class="form-text text-muted" id="fisheyePreviewStatus">{% trans "소스를 불러오는 중..." %}</small>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-2 control-label">{% trans "테스트 영상 (임시)" %}</label>
                        <div class="col-sm-10">
                            <input type="file" id="fisheyeTestVideoInput" accept="video/mp4,video/webm,video/quicktime">
                            <button type="button" class="btn btn-sm btn-white" id="fisheyeTestVideoUploadBtn">{% trans "업로드" %}</button>
                            <small class="form-text text-muted">{% trans "실제 카메라 없이 캘리브레이션을 테스트하기 위한 임시 기능입니다 (추후 제거 예정)." %}</small>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-2 control-label" for="centerX">{% trans "중심 X / Y" %}</label>
                        <div class="col-sm-5">
                            <input type="range" class="form-control-range" id="centerX" name="centerX" min="0" max="100" step="0.1" value="{{ fisheyeParams.cx }}">
                        </div>
                        <div class="col-sm-5">
                            <input type="range" class="form-control-range" id="centerY" name="centerY" min="0" max="100" step="0.1" value="{{ fisheyeParams.cy }}">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-2 control-label" for="radius">{% trans "반지름" %}</label>
                        <div class="col-sm-10">
                            <input type="range" class="form-control-range" id="radius" name="radius" min="10" max="150" step="0.1" value="{{ fisheyeParams.rad }}">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-2 control-label" for="radiusInner">{% trans "안쪽/바깥쪽 제외 반지름" %}</label>
                        <div class="col-sm-5">
                            <input type="range" class="form-control-range" id="radiusInner" name="radiusInner" min="0" max="0.95" step="0.005" value="{{ fisheyeParams.rin }}">
                        </div>
                        <div class="col-sm-5">
                            <input type="range" class="form-control-range" id="radiusOuter" name="radiusOuter" min="0.1" max="1.2" step="0.005" value="{{ fisheyeParams.rout }}">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-2 control-label" for="rotationDeg">{% trans "시작 각도 / 렌즈 보정" %}</label>
                        <div class="col-sm-5">
                            <input type="range" class="form-control-range" id="rotationDeg" name="rotationDeg" min="0" max="360" step="0.5" value="{{ fisheyeParams.rot }}">
                        </div>
                        <div class="col-sm-5">
                            <input type="range" class="form-control-range" id="lensCorrection" name="lensCorrection" min="-0.5" max="0.5" step="0.01" value="{{ fisheyeParams.lens }}">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-2 control-label" for="fisheyeFov">{% trans "어안 FOV" %}</label>
                        <div class="col-sm-10">
                            <input type="range" class="form-control-range" id="fisheyeFov" name="fisheyeFov" min="150" max="230" step="1" value="{{ fisheyeParams.ffov }}">
                        </div>
                    </div>

                    {% set modeOptions = [{id: "seg", value: "파노라마 분할"}, {id: "ptz", value: "가상 PTZ"}] %}
                    {{ forms.dropdown("mode", "dropdown", "뷰 모드"|trans, fisheyeParams.mode, modeOptions, "id", "value", "") }}

                    {% set layoutOptions = [
                        {id: "L1", value: "1"},
                        {id: "L2H", value: "2 가로"},
                        {id: "L2V", value: "2 세로"},
                        {id: "L4", value: "2x2"},
                        {id: "L13", value: "1+3"}
                    ] %}
                    {{ forms.dropdown("layout", "dropdown", "페인 레이아웃"|trans, fisheyeParams.layout, layoutOptions, "id", "value", "") }}

                    {% set aspectOptions = [
                        {id: "8", value: "8:1"},
                        {id: "6", value: "6:1"},
                        {id: "4", value: "4:1"},
                        {id: "3", value: "3:1"},
                        {id: "2", value: "2:1"},
                        {id: "1.7778", value: "16:9"},
                        {id: "1.3333", value: "4:3"}
                    ] %}
                    {{ forms.dropdown("aspect", "dropdown", "출력 종횡비"|trans, fisheyeParams.aspect, aspectOptions, "id", "value", "") }}

                    <div class="form-group row">
                        <label class="col-sm-2 control-label">{% trans "기본값" %}</label>
                        <div class="col-sm-10">
                            {{ forms.checkbox("flip", "상하 반전"|trans, fisheyeParams.flip, "", "d-inline-block mr-4") }}
                            {{ forms.checkbox("ccw", "반시계"|trans, fisheyeParams.ccw, "", "d-inline-block") }}
                            <small class="form-text text-muted">{% trans "상세(뷰잉) 페이지에서 기본으로 적용되는 값입니다. 뷰어는 이 값을 바탕으로 임시로만 전환할 수 있습니다." %}</small>
                        </div>
                    </div>

                    <input type="hidden" id="panes" name="panes" value="{{ fisheyeParams.panes|json_encode }}">
                </div>

            </form>
        </div>
    </div>
{% endblock %}

{% block callBack %}cameraEditFormOpen{% endblock %}
