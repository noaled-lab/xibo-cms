<div class="device-scope" id="device-scope"
     role="group" aria-label="{{ 'Displays'|trans }}"
     data-search-url="{{ url_for('display.search') }}"
     data-storage-key="device-scope-{{ currentUser.userId }}"
     data-filter-enabled="{{ route in ['schedule.view', 'layout.view', 'template.view', 'resolution.view', 'display.view', 'camera.view'] ? 'true' : 'false' }}"
     data-error="{{ 'Unable to load displays'|trans }}"
     data-unknown-resolution="{{ '해상도 정보 없음'|trans }}"
     data-resolution-prompt="{{ route in ['layout.view', 'template.view', 'resolution.view', 'schedule.view'] ? 'true' : 'false' }}"
     data-retry="{{ 'Retry'|trans }}">
    <button type="button" class="btn btn-sm device-scope-tag active"
            data-display-id="" aria-pressed="true">{{ 'All'|trans }}</button>
</div>
<div id="device-scope-resolution-notice" class="alert alert-warning device-scope-resolution-notice" role="status" hidden>
    {% trans "필터 해상도를 선택해 주세요. 디스플레이 편집에서 고를 수 있습니다." %}
</div>
